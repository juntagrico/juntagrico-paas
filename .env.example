# Database configuration
POSTGRES_DB=adminconsole
POSTGRES_USER=juntagrico
POSTGRES_PASSWORD=changeme

# Django app configuration
JUNTAGRICO_PROJECTS_DIR=/var/django/projects
JUNTAGRICO_PYTHON_BIN=python
# Set to True when running in Docker (also set in docker-compose.yml)
DOCKERIZED=1
# Nginx site configs directory (must match nginx include path)
NGINX_SITES_DIR=/etc/nginx/sites
# Database host for child apps (e.g., 'db' for Docker service name)
JUNTAGRICO_DATABASE_HOST=db
# Database port for child apps
JUNTAGRICO_DATABASE_PORT=5432
# Docker network mode: 'host' for host network, or a network name (e.g., compose network)
DOCKER_NETWORK_MODE=juntagrico-paas-net
JS_DATABASE_NAME=adminconsole
JS_DATABASE_USER=juntagrico
JS_DATABASE_PASSWORD=changeme
JS_DATABASE_HOST=db
JS_KEY=changeme-to-a-random-secret-key
# Comma-separated list of allowed hostnames. Set to your actual domain(s) in production.
DJANGO_ALLOWED_HOSTS=admin.juntagrico.app,admin.juntagrico.science
# Number of gunicorn workers (default: 3, recommended: 2×CPUs + 1)
GUNICORN_WORKERS=1

# Email configuration (for sending emails from the app)
JUNTAGRICO_EMAIL_HOST=smtp.example.com
JUNTAGRICO_EMAIL_USER=
JUNTAGRICO_EMAIL_PASSWORD=
JUNTAGRICO_EMAIL_PORT=587
JUNTAGRICO_EMAIL_TLS=true
JUNTAGRICO_EMAIL_SSL=false

# GitHub OAuth (for authentication)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin superuser (created on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

